# AIFOS paper-forward marathon — systemd unit (Raspberry Pi / Linux)
#
# Install:
#   sudo cp scripts/aifos-paper.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aifos-paper.service
#
# Manage:
#   systemctl status aifos-paper       # live state
#   journalctl -u aifos-paper -f       # follow logs
#   systemctl restart aifos-paper      # bounce
#
# Equivalent to the macOS launchd plist generated by scripts/paper-forward.sh —
# Restart=always replaces KeepAlive, RestartSec replaces ThrottleInterval, and
# journald replaces the rotating log file. The aifos-paper-watchdog.timer
# (companion unit) replaces the launchd watchdog. Same env, same behavior.
#
# IMPORTANT: edit User=, WorkingDirectory=, and the .venv path to match the box
# (Pi default is User=pi, repo cloned at ~/ai-trading-os).

[Unit]
Description=AIFOS paper-forward marathon (continuous paper trading, port 8001)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/ai-trading-os/backend

# Paper instance config (separate DB, paper broker, marathon on at boot)
Environment="AIFOS_BROKER=paper"
Environment="AIFOS_DATABASE_URL=sqlite:////home/pi/ai-trading-os/backend/paper_forward.db"
Environment="AIFOS_LLM_PROVIDER=none"
Environment="AIFOS_CONFIDENCE_THRESHOLD=0.30"
Environment="AIFOS_MAX_OPEN_POSITIONS=8"
Environment="AIFOS_AUTONOMOUS_ON_START=true"
Environment="AIFOS_MARATHON_ON_START=true"
Environment="PATH=/home/pi/ai-trading-os/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin"

ExecStart=/home/pi/ai-trading-os/backend/.venv/bin/uvicorn aifos.api.app:app \
          --host 127.0.0.1 --port 8001 --log-level warning

# Resilience: always restart, throttle so a crash-loop doesn't burn the SD card
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=60

# Memory protection on a Pi: kill before it OOMs the kernel
MemoryMax=1500M
MemoryHigh=1200M

# Logs go to journald (size-managed by the system); to view: journalctl -u aifos-paper -f

[Install]
WantedBy=default.target
