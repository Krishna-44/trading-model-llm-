# ============================================================================
# AIFOS configuration. Copy to `.env` and edit. All vars are optional — the
# platform runs fully in PAPER mode with zero configuration.
# ============================================================================

# --- App ---
AIFOS_API_PORT=8000
AIFOS_STARTING_CAPITAL=1000000
AIFOS_BASE_CURRENCY=INR

# --- Persistence (default SQLite; use Postgres/Timescale for the full stack) ---
# AIFOS_DATABASE_URL=postgresql+psycopg://aifos:aifos@localhost:5432/aifos

# --- Risk gates (the system's spine; tune with care) ---
AIFOS_CONFIDENCE_THRESHOLD=0.62      # below this the system HOLDS, no exceptions
AIFOS_MAX_POSITION_PCT=0.10
AIFOS_MAX_OPEN_POSITIONS=5
AIFOS_MAX_DAILY_LOSS_PCT=0.03        # daily loss that trips the kill switch
AIFOS_RISK_PER_TRADE_PCT=0.0075
AIFOS_MIN_RR_RATIO=1.5
AIFOS_PER_TRADE_CAP=100000           # hard absolute cap per order (base ccy)

# ============================================================================
# DANGER ZONE — LIVE TRADING. Defaults OFF. Read before changing.
# ============================================================================
# Setting this true lets the selected broker route REAL orders with REAL money.
# Validate in paper mode first. Single operator, your OWN account only.
AIFOS_LIVE_TRADING_ENABLED=false
AIFOS_BROKER=paper                   # paper | zerodha | upstox | angelone | oanda

# FEMA guard: Indian residents generally CANNOT legally trade offshore spot FX.
# Leave false unless you are legally permitted. Use INR pairs / NSE currency F&O.
AIFOS_ALLOW_OFFSHORE_FOREX=false

# Zerodha Kite Connect (paid; access_token must be regenerated daily)
# AIFOS_ZERODHA_API_KEY=
# AIFOS_ZERODHA_API_SECRET=
# AIFOS_ZERODHA_ACCESS_TOKEN=

# Angel One SmartAPI (NSE equity + currency F&O). Enable TOTP in your account first.
# AIFOS_ANGELONE_API_KEY=
# AIFOS_ANGELONE_CLIENT_CODE=
# AIFOS_ANGELONE_PIN=
# AIFOS_ANGELONE_TOTP_SECRET=

# OANDA (forex). Use the practice environment first.
# AIFOS_OANDA_API_TOKEN=
# AIFOS_OANDA_ACCOUNT_ID=
# AIFOS_OANDA_ENVIRONMENT=practice   # practice | live

# --- Alerts (optional; Telegram + Discord webhooks) ---
AIFOS_ALERTS_ENABLED=true
# AIFOS_TELEGRAM_BOT_TOKEN=
# AIFOS_TELEGRAM_CHAT_ID=
# AIFOS_DISCORD_WEBHOOK_URL=

# --- LLM agent layer (optional; augments the deterministic quant) ---
AIFOS_LLM_PROVIDER=ollama            # ollama | anthropic | openai | none
AIFOS_OLLAMA_BASE_URL=http://localhost:11434
AIFOS_OLLAMA_MODEL=llama3.1
# AIFOS_ANTHROPIC_API_KEY=
# AIFOS_OPENAI_API_KEY=
