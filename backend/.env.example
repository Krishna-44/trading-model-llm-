# AIFOS backend configuration — copy to `.env` and fill in.
# NEVER commit `.env` (it is gitignored). Secrets stay on your machine only.

# =========================================================================
# AngelOne (Angel One SmartAPI) — connect your REAL account
# =========================================================================
# 1) Create a SmartAPI app at https://smartapi.angelbroking.com/ → get the API key.
# 2) Enable TOTP on your Angel account and copy the TOTP *secret* (base32 string,
#    NOT the 6-digit code) shown during TOTP setup.
# 3) Install the SDK:  pip install -r requirements-live.txt
AIFOS_BROKER=angelone
AIFOS_ANGELONE_API_KEY=
AIFOS_ANGELONE_CLIENT_CODE=        # your Angel client / login id
AIFOS_ANGELONE_PIN=                # your login PIN
AIFOS_ANGELONE_TOTP_SECRET=        # base32 TOTP secret (NOT the 6-digit code)

# =========================================================================
# Safety: monitoring vs. real orders  (defaults = safest)
# =========================================================================
# With the creds above set, the dashboard shows your REAL holdings/positions/P&L
# (read-only). Real ORDERS stay blocked until ALL of these are true:
#   - AIFOS_LIVE_MONITOR_ONLY=false      (turn off read-only)
#   - AIFOS_LIVE_TRADING_ENABLED=true    (arm the master switch)
#   - go-live readiness gates pass        (the staged-deployment safety gate)
#   - AIFOS_DEPLOYMENT_STAGE=micro/scaling
# Keep these defaults until the paper forward-test has EARNED real money.
AIFOS_LIVE_MONITOR_ONLY=true       # true = monitor only, NO real orders
AIFOS_LIVE_TRADING_ENABLED=false   # master switch for real orders
AIFOS_DEPLOYMENT_STAGE=paper       # paper | micro | scaling

# =========================================================================
# Local LLM (Ollama) — free, no billing, runs on your machine
# =========================================================================
# Used to enrich the Video -> Strategy extractor and Vision answers. Optional:
# if Ollama isn't running, the system falls back to cloud (if keys set) then to
# an on-device keyword reader — nothing breaks.
#   1) brew services start ollama       (or: ollama serve)
#   2) ollama pull llama3               (or mistral / phi3)
#   3) set the model below to one you've pulled (`ollama list`)
AIFOS_LLM_PROVIDER=ollama          # ollama | anthropic | openai | none
AIFOS_OLLAMA_BASE_URL=http://localhost:11434
AIFOS_OLLAMA_MODEL=llama3          # must match a pulled model
# AIFOS_ANTHROPIC_API_KEY=         # optional cloud fallback
# AIFOS_OPENAI_API_KEY=            # optional cloud fallback
